{
  "name": "bundai: Learn Japanese With Anime",
  "displayName": "Bundai-Japanese Anime Dual Subtitle Loader",
  "version": "2.3.35",
  "description": "A Japanese language learning, chromium based web extension",
  "author": "bundai",
  "scripts": {
    "dev": "node scripts/prepare-browser-whisper-runtime.mjs && plasmo dev",
    "build": "node scripts/prepare-browser-whisper-runtime.mjs && rm -rf build && plasmo build && mv build/chrome-mv3-prod build/prod && rm -rf build/chrome-mv3-dev 2>/dev/null; true",
    "package": "plasmo package",
    "asr:local": "python3 scripts/local_asr_server.py"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@huggingface/transformers": "^3.8.1",
    "@plasmohq/storage": "^1.15.0",
    "graphql": "^16.11.0",
    "kuromoji": "^0.1.2",
    "lodash": "^4.17.21",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "plasmohq": {
    "artifactName": "bundai-extension"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "storage",
      "tabs",
      "cookies",
      "tabCapture"
    ],
    "host_permissions": [
      "*://youtube.com/*",
      "*://www.youtube.com/*",
      "*://huggingface.co/*",
      "*://*.huggingface.co/*",
      "https://api.bundai.app/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/*",
          "node_modules/kuromoji/dict/*.dat.gz",
          "assets/data/japanese/words.idx",
          "assets/data/japanese/words.ljson",
          "assets/whisper-worker.mjs",
          "assets/onnxruntime/*",
          "assets/transformers/*"
        ],
        "matches": [
          "*://*.youtube.com/*"
        ]
      },
      {
        "resources": [
          "assets/whisper-worker.mjs",
          "assets/onnxruntime/*",
          "assets/transformers/*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}
